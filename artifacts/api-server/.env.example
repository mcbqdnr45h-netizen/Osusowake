# ── api-server 環境変数テンプレート ─────────────────────────────
# 使い方:
#   cp .env.example .env
# その後、各値を埋める。`.env` は .gitignore 済み（コミットされない）。
# 起動: pnpm --filter @workspace/api-server dev

# ── 必須（未設定だと起動時に throw）──────────────────────────────
# 待ち受けポート（例: 3001）
PORT=
# Supabase プロジェクト URL（例: https://xxxx.supabase.co）
SUPABASE_URL=
# Supabase anon key
SUPABASE_ANON_KEY=
# Supabase service_role key（管理者権限・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=
# Supabase の Postgres 接続文字列（?sslmode=require 付き）
SUPABASE_DATABASE_URL=

# ── 任意（未設定でも起動可・該当機能のみ無効化）──────────────────
# 決済（未設定時はモック決済で動作）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_CONNECT=

# AI カテゴリ判定（OpenAI 公式 SDK）
OPENAI_API_KEY=

# Web Push 通知（VAPID）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@osusowakejapan.org

# iOS Push（APNs）
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# メール送信（Resend）
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# 管理者承認リンクの署名シークレット
ADMIN_APPROVAL_SECRET=

# アプリ URL / ドメイン
APP_URL=http://localhost:5173
APP_DOMAIN=
OSUSOWAKE_PUBLIC_URL=

# App Store 審査用（本番のみ設定・通常は空で fail-closed）
APP_REVIEW_BYPASS_EMAILS=
APP_REVIEW_DEMO_OWNER_IDS=
