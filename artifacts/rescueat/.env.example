# ── rescueat (フロントエンド) 環境変数テンプレート ───────────────
# 使い方:
#   cp .env.example .env.local
# その後、各値を埋める。`.env.local` は .gitignore 済み（コミットされない）。

# ── Supabase（必須・アプリが import.meta.env で参照）──────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── API 接続先（ローカル開発では必須）────────────────────────────
# api-server の URL。空にすると同一オリジンの相対パスになり dev では届かない。
VITE_API_BASE=http://localhost:3001

# ── 任意（アプリが import.meta.env で参照）────────────────────────
VITE_GOOGLE_MAP_ID=

# ─────────────────────────────────────────────────────────────────
# ⚠️ 次の値は vite.config.ts が process.env を直接読むため、
#    .env.local に書いても効かない。dev/preview 起動時にシェルで渡すこと:
#
#      PORT=5173 BASE_PATH=/ VITE_MAPS_API_KEY=xxxx \
#        pnpm --filter @workspace/rescueat dev
#
#    PORT / BASE_PATH は未設定だと Vite が起動時に throw する。
#    VITE_MAPS_API_KEY は未設定時 vite.config のフォールバック鍵を使用。
# ─────────────────────────────────────────────────────────────────
