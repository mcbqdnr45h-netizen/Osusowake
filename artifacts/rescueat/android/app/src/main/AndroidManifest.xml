<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ★ 2026-08-12 サイトのリンクをアプリで開く (App Links)。
                 これが無いと LINE やメールに貼った osusowakejapan.org のリンクを
                 踏んでも【ブラウザが開くだけでアプリが起動しない】。
                 autoVerify=true にすると、インストール時に Android が
                 https://osusowakejapan.org/.well-known/assetlinks.json を取得して
                 署名を照合する（サーバー側で配信済み）。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="osusowakejapan.org" />
                <data android:scheme="https" android:host="www.osusowakejapan.org" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ★ プッシュ通知のステータスバー用アイコン。Android は白シルエット+透過が必須で、
             未指定だとランチャーアイコンが単色の四角に潰れて表示される。手のロゴの
             シルエット (ic_stat_notify) とブランドピンクを明示指定して iPhone 同等の見た目にする。 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationIconColor" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ネットワーク状態確認 (Capacitor Network plugin / オフライン検知) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 位置情報 (店舗マップで「現在地から近い順」 + 通勤時間圏内表示) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- カメラ (店舗写真・営業許可証画像のアップロード) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知 (FCM 経由のプッシュ通知。 Android 13+ で必須) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 振動 (通知時のフィードバック) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ハードウェア機能 -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
